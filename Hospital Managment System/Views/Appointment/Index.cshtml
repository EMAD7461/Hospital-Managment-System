@model IEnumerable<Hospital_Managment_System.Models.Appointment>
<link rel="stylesheet" href="~/css/style.css">

@{
    ViewData["Title"] = "Appointments";
}

<h2>Appointments</h2>

<p>
    <a asp-controller="Appointment" asp-action="Create" class="btn btn-primary">Create New Appointment</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Patient Name</th>
            <th>Doctor</th>
            <th>Appointment Date</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var appointment in Model)
        {
            <tr>
                <td>@appointment.PatientName</td>
                <td>@appointment.Doctor?.Name</td>
                <td>@appointment.AppointmentDate.ToShortDateString()</td>
                <td>@appointment.Speciality</td>
                <td>@appointment.Status</td>
                <td>
                    <a asp-controller="Appointment" asp-action="Edit" asp-route-id="@appointment.Id" class="btn btn-warning">Edit</a>
                    <a asp-controller="Appointment"  asp-action="Delete" asp-route-id="@appointment.Id" class="btn btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
